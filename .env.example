# Copy this file to .env.local and fill it in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Link the app to your US sandbox Business account ("Clasp Platform").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# direct_payee: PayPal pays the seller's account named on the order (default).
# platform_payout: Clasp is the payee and forwards money to the seller with the Payouts API.
PAYPAL_SETTLEMENT=direct_payee

# Set after you add a webhook in the PayPal dashboard (needs a public URL, e.g. your Render app).
PAYPAL_WEBHOOK_ID=

# OpenAI (platform.openai.com/api-keys). Any current OpenAI model with image input works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Leave empty to use the built-in local database (stored in ./.data).
# On Render, set this to your Render Postgres "Internal Database URL".
DATABASE_URL=

APP_URL=http://localhost:3000
