# Copy this file to .env.local and fill it in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Link the app to your US sandbox Business account ("Clasp Platform").
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# platform_payout (default): Clasp holds the buyer's funds and pays the seller with Payouts after verification.
# direct_payee: names the seller as payee. PayPal refuses AUTHORIZE holds for third-party payees unless you are an approved partner.
PAYPAL_SETTLEMENT=platform_payout

# Set after you add a webhook in the PayPal dashboard (needs a public URL, e.g. your Render app).
PAYPAL_WEBHOOK_ID=

# OpenAI (platform.openai.com/api-keys). Any current OpenAI model with image input works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Leave empty to use the built-in local database (stored in ./.data).
# On Render, set this to your Render Postgres "Internal Database URL".
DATABASE_URL=

APP_URL=http://localhost:3000

# Buyer protection fee in basis points (500 = 5%, minimum $1), added on top of the price.
# Only applies with PAYPAL_SETTLEMENT=platform_payout, since Clasp must receive it.
CLASP_FEE_BPS=500

# Web push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional email notifications via Resend (resend.com). Leave empty to disable.
RESEND_API_KEY=
EMAIL_FROM=Clasp <onboarding@resend.dev>
